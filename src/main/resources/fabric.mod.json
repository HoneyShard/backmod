{
  "schemaVersion": 1,
  "id": "retromod",
  "version": "${project.version}",
  "name": "Backmod",
  "description": "Backports Fabric mods built for Minecraft 26.2 so they load on 26.1.2, by rewriting their bytecode, mixins, and loader metadata. Fork of Retromod.",
  "authors": ["Bownlux"],
  "contact": {
    "homepage": "https://github.com/HoneyShard/backmod",
    "sources": "https://github.com/HoneyShard/backmod",
    "issues": "https://github.com/HoneyShard/backmod/issues"
  },
  "license": "MIT",
  "icon": "assets/retromod/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.retromod.core.Retromod"],
    "client": ["com.retromod.core.RetromodClient"],
    "server": ["com.retromod.core.RetromodServer"],
    "preLaunch": ["com.retromod.core.RetromodPreLaunch", "com.retromod.backport.BackportPreLaunch"]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": ">=1.20",
    "java": ">=17"
  },
  "suggests": {
    "fabric-api": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://github.com/HoneyShard/backmod",
        "modmenu.issues": "https://github.com/HoneyShard/backmod/issues"
      }
    }
  }
}
